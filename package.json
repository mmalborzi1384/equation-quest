{
  "name": "equation-quest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Persian-first Equation Quest web foundation; later educational/game phases remain pending.",
  "scripts": {
    "check:deps": "npm ls --depth=0",
    "lint": "eslint .",
    "format:check": "prettier --check package.json eslint.config.mjs .prettierrc.json \"src/**/*.{ts,tsx,css}\" \"*.{ts,tsx,html}\" \"tests/**/*.{ts,tsx}\"",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "check:phase9": "node scripts/check-phase9-budgets.mjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "gsap": "3.15.0",
    "katex": "0.19.1",
    "lucide-react": "1.67.0",
    "prop-types": "15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-katex": "3.1.0",
    "react-router-dom": "7.18.5",
    "three": "0.187.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.22.3",
    "npm": "10.9.8"
  }
}
